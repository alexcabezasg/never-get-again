    "js-yaml": "^4.1.0",
    "mongodb": "^6.20.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "jest": "^30.0.5",
